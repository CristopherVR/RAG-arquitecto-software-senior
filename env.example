# ============================================================
# SISTEMA RAG — ARQUITECTO DE SOFTWARE SENIOR
# Universidad Mariano Gálvez de Guatemala
# ============================================================
# Copia este archivo como .env y rellena tus valores.
# NUNCA subas el archivo .env a Git.
# ============================================================


# ------------------------------------------------------------
# LLM — elige una opción y deja las demás vacías
# ------------------------------------------------------------

# Opción 1: OpenAI
OPENAI_API_KEY=sk-...

# Opción 2: Groq (Llama 3 — gratuito y rápido)
GROQ_API_KEY=gsk_...

# Opción 3: Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (ejemplos: gpt-4o, llama3-8b-8192, claude-3-5-sonnet-20241022)
LLM_MODEL=llama3-8b-8192
LLM_PROVIDER=groq


# ------------------------------------------------------------
# BASE DE DATOS VECTORIAL
# ------------------------------------------------------------

# Ruta local donde ChromaDB guarda los datos
CHROMA_PATH=./chroma_db

# Nombre de la colección dentro de ChromaDB
CHROMA_COLLECTION=rag_arquitecto


# ------------------------------------------------------------
# EMBEDDINGS
# ------------------------------------------------------------

# Modelo de sentence-transformers (corre local, sin API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2


# ------------------------------------------------------------
# INGESTA — REPOSITORIO GIT
# ------------------------------------------------------------

# URL del repositorio a clonar
REPO_URL=https://github.com/usuario/repositorio.git

# Carpeta local donde se clona
LOCAL_REPO=./repos/project


# ------------------------------------------------------------
# CHUNKING
# ------------------------------------------------------------

CHUNK_SIZE=1500
CHUNK_OVERLAP=150


# ------------------------------------------------------------
# INTERFAZ (Streamlit)
# ------------------------------------------------------------

# Puerto donde corre la app
STREAMLIT_PORT=8501


# ------------------------------------------------------------
# VOZ (OPCIONAL)
# ------------------------------------------------------------

# Whisper: modelo a usar (tiny, base, small, medium)
WHISPER_MODEL=base

# gTTS: idioma para síntesis de voz
TTS_LANGUAGE=es
